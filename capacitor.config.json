{
  "appId": "com.kingmaker.world",
  "appName": "KINGMAKER",
  "webDir": "www",
  "bundledWebRuntime": false,
  "backgroundColor": "#0b1220",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "automatic",
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "backgroundColor": "#0b1220",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b1220"
    }
  }
}
